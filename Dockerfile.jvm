FROM registry.access.redhat.com/ubi9/openjdk-17-runtime:1.24

USER 0
ENV HOME=/app
WORKDIR /app

COPY --chown=0:0 --chmod=0444 build/libs/interlis-repo-checker-*-exec.jar ./application.jar

USER 1001:0
EXPOSE 8080
ENV LOG4J_FORMAT_MSG_NO_LOOKUPS=true

CMD ["java", "-XX:MaxRAMPercentage=80.0", "-XX:-UseBASE64Intrinsics", "-Duser.home=/tmp", "-jar", "application.jar"]
